<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ve altı için otomatik yedek kuralları. allowBackup="false" zaten yedeği kapatır;
     bu dosya, ileride allowBackup açılsa bile sırların (shared_prefs, uygulama dosyaları) yedeğe girmemesini sağlar. -->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
</full-backup-content>
